@@ -686,6 +686,53 @@ struct MinidumpContextRISCV64 {
   uint32_t fcsr;
 };
 
+//! \brief 64-bit LoongArch-specific flags for
+//! MinidumpContextLoongArch64::context_flags.
+enum MinidumpContextLoongArch64Flags : uint32_t {
+  //! \brief Identifies the context structure as LoongArch64.
+  kMinidumpContextLoongArch64 = 0x00008000,
+
+  //! \brief Indicates the validity of integer registers.
+  kMinidumpContextLoongArch64Integer =
+      kMinidumpContextLoongArch64 | 0x00000002,
+
+  //! \brief Indicates the validity of floating point registers.
+  kMinidumpContextLoongArch64FloatingPoint =
+      kMinidumpContextLoongArch64 | 0x00000004,
+
+  //! \brief Indicates the validity of all registers.
+  kMinidumpContextLoongArch64All = kMinidumpContextLoongArch64Integer |
+                                 kMinidumpContextLoongArch64FloatingPoint,
+};
+
+//! \brief A 64-bit LoongArch CPU context (register state) carried in a minidump
+//!     file.
+struct MinidumpContextLoongArch64 {
+  //! \brief Indicates the validity of fields in this structure.
+  uint32_t context_flags;
+
+  //! \brief Reserved for alignment, must be zero.
+  uint32_t pad0;
+
+  //! \brief General purpose registers r0-r31.
+  uint64_t regs[32];
+
+  //! \brief Exception Return Address (PC).
+  uint64_t csr_era;
+
+  //! \brief Raw bits of the 32 64-bit FPU registers.
+  uint64_t fpregs[32];
+
+  //! \brief FPU condition code register.
+  uint64_t fcc;
+
+  //! \brief FPU control and status register.
+  uint32_t fcsr;
+
+  //! \brief Explicit tail padding, must be zero.
+  uint32_t pad1;
+};
+
 }  // namespace crashpad
 
 #endif  // CRASHPAD_MINIDUMP_MINIDUMP_CONTEXT_H_
diff --git third_party/crashpad/crashpad/minidump/minidump_context_writer.cc third_party/crashpad/crashpad/minidump/minidump_context_writer.cc
index 4a6130b63e954..f68400521c6a3 100644
--- third_party/crashpad/crashpad/minidump/minidump_context_writer.cc
